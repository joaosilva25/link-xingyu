# Copie para .env.local (ignorado pelo Git).
#   cp .env.example .env.local

# Local: URL de conexão externa. Produção (mesma rede do banco): URL interna.
DATABASE_URL=mysql://usuario:senha@host:porta/banco

ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# true (só em desenvolvimento e sem DATABASE_URL) mostra dados de demonstração no painel; o login continua obrigatório
ADMIN_PREVIEW_MODE=false
